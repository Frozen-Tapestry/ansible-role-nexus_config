{% set payload = {
  "name": item.name,
  "online": item.online,
  "storage": {
    "blobStoreName": item.blob_store,
    "strictContentTypeValidation": item.strict_content_type_validation,
    "writePolicy": item.write_policy
  },
  "docker": {
    "v1Enabled": item.v1_enabled,
    "forceBasicAuth": item.force_basic_auth
  }
} %}
{% if item.cleanup_names is defined %}
{% set payload = payload | combine({
  "cleanup": {
    "policyNames": item.cleanup_names
  }
}) %}
{% endif %}

{{ payload | to_nice_json }}
